{
  "name": "tutorialgen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Script-driven tutorial video generator: TTS narration + headless Playwright screen recording, muxed into one mp4.",
  "bin": {
    "tutorialgen": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "setup:browser": "playwright install chromium"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "msedge-tts": "^2.0.7",
    "playwright": "^1.62.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
